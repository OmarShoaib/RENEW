<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.MainActivity">

    <data>

        <import type="android.view.View" />

        <variable
            name="callback"
            type="edu.aku.omarshoaib.renew.activity.MainActivity" />
    </data>


    <RelativeLayout
        style="@style/Theme.AppStructure.Background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <include layout="@layout/view_appbar" />

        <ImageView
            android:id="@+id/appLogoIV"
            android:layout_width="@dimen/_75sdp"
            android:layout_height="@dimen/_75sdp"
            android:layout_below="@+id/appBarLayout"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_25sdp"
            android:background="@drawable/bg_circle_white_filled"
            android:elevation="@dimen/_3sdp"
            android:padding="@dimen/_2sdp"
            android:src="@drawable/app_icon"
            tools:ignore="ContentDescription" />

        <!--Summary Button-->
        <!--<com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/summary"
            style="@style/Theme.AppStructure.ButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/appLogoIV"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/_minus25sdp"
            android:layout_marginEnd="@dimen/_13sdp"
            android:alpha="0.7"
            android:backgroundTint="@color/red_color"
