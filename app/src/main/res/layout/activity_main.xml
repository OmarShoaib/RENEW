            android:onClick="@{callback::openForm}"
            app:backgroundTint="@color/red_color"
            app:borderWidth="0dp"
            app:elevation="@dimen/_2sdp"
            app:fabCustomSize="@dimen/_30sdp"
            app:maxImageSize="@dimen/_17sdp"
            app:rippleColor="@color/red_color_light"
            app:srcCompat="@drawable/ic_summary"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/summaryTitleTV"
            style="@style/Theme.AppStructure.SmallBoldText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/summary"
            android:layout_alignStart="@+id/summary"
            android:layout_alignEnd="@+id/summary"
            android:elevation="@dimen/_1sdp"
            android:gravity="center"
            android:text="@string/summary"
            android:textColor="@color/light_gray_color"
            android:textSize="@dimen/_6ssp" />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/appLogoIV"
            android:layout_marginTop="@dimen/_minus35sdp"
            android:background="@drawable/top_round_shape"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_25sdp">

            <TextView
                style="@style/Theme.AppStructure.TitleBoldText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:elevation="@dimen/_1sdp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center_horizontal|center_vertical"
                android:text="@string/main_screen"
                android:textColor="@color/primary_color"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        style="@style/cardView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:id="@+id/option1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:onClick="@{callback::openForm}"
                            android:padding="@dimen/_10sdp">

                            <ImageView
                                android:id="@+id/siIV"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_centerVertical="true"
                                android:background="@drawable/ic_interview"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:id="@+id/siTitleTV"
                                style="@style/Theme.AppStructure.BoldText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_toStartOf="@+id/siArrowIV"
                                android:layout_toEndOf="@+id/siIV"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center_vertical"
                                android:text="@string/start_interview"
                                android:textColor="@color/primary_color"
                                android:textSize="@dimen/_9ssp" />

                            <TextView
                                android:id="@+id/siSubTitleTV"
                                style="@style/Theme.AppStructure.SmallRegularText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/siTitleTV"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_toStartOf="@+id/siArrowIV"
                                android:layout_toEndOf="@+id/siIV"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center_vertical"
                                android:text="@string/open_form"
                                android:textColor="@color/gray_dark" />

                            <ImageView
                                android:id="@+id/siArrowIV"
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/ic_item_right_arrow"
                                android:backgroundTint="@color/primary_color"
                                android:textColor="@color/secondary_color_accent"
                                tools:ignore="ContentDescription" />

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!--Summary Button-->
                        <androidx.cardview.widget.CardView
                            style="@style/cardView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:foreground="@drawable/bg_rounded_sec_transparent_bordered">

                            <RelativeLayout
                                android:id="@+id/summaryLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:onClick="@{callback::openForm}"
                                android:padding="@dimen/_7sdp">

                                <ImageView
                                    android:id="@+id/summaryIV"
                                    android:layout_width="@dimen/_30sdp"
                                    android:layout_height="@dimen/_30sdp"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/ic_summary"
                                    android:backgroundTint="@color/secondary_color_dark"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:id="@+id/summaryTitleTV"
                                    style="@style/Theme.AppStructure.BoldText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    android:layout_marginTop="@dimen/_3sdp"
                                    android:layout_toStartOf="@+id/summaryArrowIV"
                                    android:layout_toEndOf="@+id/summaryIV"
                                    android:fontFamily="@font/roboto_regular"
                                    android:gravity="center_vertical"
                                    android:text="@string/summary"
                                    android:textAllCaps="true"
                                    android:textColor="@color/secondary_color_dark"
                                    android:textSize="@dimen/_9ssp" />

                                <TextView
                                    android:id="@+id/summarySubTitleTV"
                                    style="@style/Theme.AppStructure.SmallRegularText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/summaryTitleTV"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    android:layout_toStartOf="@+id/summaryArrowIV"
                                    android:layout_toEndOf="@+id/summaryIV"
                                    android:fontFamily="@font/roboto_regular"
                                    android:gravity="center_vertical"
                                    android:text="@string/summary_desc"
                                    android:textColor="@color/gray_dark" />

                                <ImageView
                                    android:id="@+id/summaryArrowIV"
                                    android:layout_width="@dimen/_12sdp"
                                    android:layout_height="@dimen/_12sdp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/ic_item_right_arrow"
                                    android:backgroundTint="@color/secondary_color_dark"
                                    tools:ignore="ContentDescription" />

                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                        <!--View Synced Recs Button-->
                        <androidx.cardview.widget.CardView
                            style="@style/cardView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:foreground="@drawable/bg_rounded_app_transparent_bordered"
                            android:visibility="gone">

                            <RelativeLayout
                                android:id="@+id/syncedRecsLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:onClick="@{callback::openForm}"
                                android:padding="@dimen/_7sdp">

                                <ImageView
                                    android:id="@+id/syncedRecsIV"
                                    android:layout_width="@dimen/_30sdp"
                                    android:layout_height="@dimen/_30sdp"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/ic_summary"
                                    android:backgroundTint="@color/primary_color"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:id="@+id/syncedRecsTitleTV"
                                    style="@style/Theme.AppStructure.BoldText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    android:layout_marginTop="@dimen/_3sdp"
                                    android:layout_toStartOf="@+id/syncedRecsArrowIV"
                                    android:layout_toEndOf="@+id/syncedRecsIV"
                                    android:fontFamily="@font/roboto_regular"
                                    android:gravity="center_vertical"
                                    android:text="@string/synced"
                                    android:textAllCaps="true"
                                    android:textColor="@color/primary_color"
                                    android:textSize="@dimen/_9ssp" />

                                <TextView
                                    android:id="@+id/syncedRecsSubTitleTV"
                                    style="@style/Theme.AppStructure.SmallRegularText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/syncedRecsTitleTV"
                                    android:layout_marginStart="@dimen/_8sdp"
                                    android:layout_toStartOf="@+id/syncedRecsArrowIV"
                                    android:layout_toEndOf="@+id/syncedRecsIV"
                                    android:fontFamily="@font/roboto_regular"
                                    android:gravity="center_vertical"
                                    android:text="@string/view_synced_recs_desc"
                                    android:textColor="@color/gray_dark" />

                                <ImageView
                                    android:id="@+id/syncedRecsArrowIV"
                                    android:layout_width="@dimen/_12sdp"
                                    android:layout_height="@dimen/_12sdp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/ic_item_right_arrow"
                                    android:backgroundTint="@color/primary_color"
                                    tools:ignore="ContentDescription" />

                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <!--INTRO LAYOUT-->
        <RelativeLayout
            android:id="@+id/lockedLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="@dimen/_2sdp"
            android:orientation="vertical"
            tools:visibility="gone">

            <ImageView
                android:id="@+id/lockedBG"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.85"
                android:background="@drawable/bg_sync"
                android:clickable="false"
                android:elevation="@dimen/_2sdp"
                android:focusable="true"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/lockedTitleTV"
                style="@style/Theme.AppStructure.TitleBoldText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_150sdp"
                android:elevation="@dimen/_2sdp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center_horizontal"
                android:text="@string/download_data"
                android:textColor="@color/white"
                android:textSize="@dimen/_17ssp" />

            <TextView
                android:id="@+id/lockedDescTV"
                style="@style/Theme.AppStructure.RegularText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lockedTitleTV"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:elevation="@dimen/_2sdp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center_horizontal"
                android:text="@string/download_data_desc_2"
                android:textColor="@color/white" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_40sdp"
                android:clickable="true"
                android:elevation="@dimen/_2sdp"
                android:focusable="true"
                tools:ignore="ContentDescription" />
        </RelativeLayout>
    </RelativeLayout>
</layout>