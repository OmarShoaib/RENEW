<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <include layout="@layout/view_appbar" />

        <RelativeLayout
            android:id="@+id/GrpName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/main_padding">

            <LinearLayout
                android:id="@+id/filterLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/bg_rounded_white_filled"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleTV"
                    style="@style/Theme.AppStructure.TitleBoldText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/top_round_shape"
                    android:backgroundTint="@color/primary_color"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center"
                    android:text="@string/list_of_children_for_followUp"
                    android:textColor="@color/white" />

                <RadioGroup
                    android:id="@+id/searchRG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/main_padding">

                    <RadioButton
                        android:id="@+id/wraNameRB"
                        style="@style/Theme.AppStructure.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:checked="false"
                        android:fontFamily="@font/roboto_regular"
                        android:tag="1"
                        android:text="@string/name" />

                    <RadioButton
                        android:id="@+id/pidRB"
                        style="@style/Theme.AppStructure.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:checked="false"
                        android:fontFamily="@font/roboto_regular"
                        android:tag="2"
                        android:text="@string/pid" />

                    <RadioButton
                        android:id="@+id/cNoRB"
                        style="@style/Theme.AppStructure.RadioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:checked="false"
                        android:fontFamily="@font/roboto_regular"
                        android:tag="3"
                        android:text="@string/contactnum" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_padding"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/main_padding">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_gray_bordered"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_10sdp">

                        <com.edittextpicker.aliazaz.EditTextPicker
                            android:id="@+id/searchET"
                            style="@style/Theme.AppStructure.EditTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:layout_toStartOf="@+id/clearSearchBtn"
                            android:background="@android:color/transparent"
                            android:digits="@string/digits_all"
                            android:fontFamily="@font/roboto_regular"
                            android:hint="@string/search"
                            android:inputType="text"
                            app:mask=""
                            tools:ignore="Autofill" />

                        <ImageView
                            android:id="@+id/clearSearchBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/ic_close_red"
                            android:visibility="gone"
                            tools:ignore="ContentDescription" />
                        <!--android:onClick="clearSearch"-->

                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/searchBtn"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="0dp"
                        android:src="@drawable/ic_search"
                        android:visibility="gone"
                        tools:ignore="ContentDescription" />
                    <!--android:onClick="filterForms"-->
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mwraRV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/filterLayout"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="10"
                tools:listitem="@layout/item_followup" />

            <TextView
                android:id="@+id/emptyTV"
                style="@style/Theme.AppStructure.TitleRegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_rounded_white_filled"
                android:padding="@dimen/_5sdp"
                android:text="@string/no_records_found"
                android:textColor="@color/red_color_light"
                android:visibility="gone" />

        </RelativeLayout>
    </LinearLayout>
</layout>