<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.sections.woman.Section1.ParticipantListAC">

    <data>

        <import type="android.view.View" />

        <!--<variable
            name="callback"
            type="edu.aku.omarshoaib.renew.activity.sections.woman.Section1.ParticipantListAC" />-->
    </data>

    <LinearLayout
        android:id="@+id/topLayout"
        style="@style/Theme.AppStructure.Background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_appbar" />

        <RelativeLayout
            android:id="@+id/GrpName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/main_padding">

            <RelativeLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginVertical="@dimen/_5sdp"
                android:background="@drawable/bg_rounded_white_filled"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/main_padding">

                <TextView
                    android:id="@+id/titleTV"
                    style="@style/Theme.AppStructure.BoldText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="@string/participant_list"
                    android:textColor="@color/light_gray_color" />

                <TextView
                    android:id="@+id/totalTV"
                    style="@style/Theme.AppStructure.TitleRegularText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="0" />

            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/endButtonsLayout"
                android:layout_below="@+id/headerLayout"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:paddingTop="0dp"
                android:paddingBottom="@dimen/_10sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="10" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/addMoreBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/endButtonsLayout"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:onClick="btnAddMore"
                app:backgroundTint="@color/secondary_color_dark"
                app:fabCustomSize="@dimen/_35sdp"
                app:maxImageSize="@dimen/_20sdp"
                app:srcCompat="@drawable/ic_add"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/emptyTV"
                style="@style/Theme.AppStructure.TitleRegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_rounded_white_filled"
                android:padding="@dimen/_5sdp"
                android:text="@string/no_records_found"
                android:textColor="@color/gray_dark"
                android:visibility="gone" />

            <!--EndButton Layout-->

            <edu.aku.omarshoaib.renew.global.views.AppEndButtons
                android:id="@+id/endButtonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
</layout>