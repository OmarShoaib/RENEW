									android:text="@string/b102a01" />

<CheckBox
android:id="@+id/b102a02"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
android:checked="@{form.b102a02.equals(`2`)}"
									android:onClick="@{()->form.setB102a02(form.b102a02.equals(`2`)?``:`2`)}"

									android:text="@string/b102a02" />

<CheckBox
android:id="@+id/b102a03"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
android:checked="@{form.b102a03.equals(`3`)}"
									android:onClick="@{()->form.setB102a03(form.b102a03.equals(`3`)?``:`3`)}"

									android:text="@string/b102a03" />

<CheckBox
									android:id="@+id/b102a96"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"

android:checked="@{form.b102a96.equals(`96`)}"
									android:onClick="@{()->form.setB102a96(form.b102a96.equals(`96`)?``:`96`)}"
									android:text="@string/b102a96" />                        
									
									<EditText
										style="@style/Theme.AppStructure.EditTextStyle"
										android:id="@+id/b102a96x" 
										android:layout_width="match_parent"
										android:layout_height="wrap_content" 
										android:hint="@string/b102a96"
										android:digits="@string/digits_all"
										android:maxLength="250"
										android:inputType="text"
										android:tag="b102a96"
android:text="@={form.b102a96x}"
										android:visibility="@{form.b102a96.equals(`96`) ? View.VISIBLE : View.GONE}"
										tools:hint="@string/b102a96x"
										tools:ignore="Autofill" />
</LinearLayout>
</LinearLayout>
</androidx.cardview.widget.CardView>

