<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/bottomSheetLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottomsheet"
        android:paddingStart="@dimen/_20sdp"
        android:paddingTop="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:paddingBottom="@dimen/_10sdp">

        <View
            android:id="@+id/bsHandleView"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_2sdp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_10sdp"
            android:alpha="0.3"
            android:background="@color/black" />

        <Button
            android:id="@+id/bsCloseBtn"
            style="@style/Theme.AppStructure.ButtonStyle"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/ic_close"
            android:backgroundTint="@color/error_color"
            android:padding="0dp"
            android:text="@string/close"
            android:textSize="@dimen/_13ssp"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/bsTitleTV"
            style="@style/Theme.AppStructure.TitleBoldText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bsCloseBtn"
            android:layout_marginBottom="@dimen/_15sdp"
            android:textColor="@color/text_color" />

        <TextView
            android:id="@+id/bsErrorTV"
            style="@style/Theme.AppStructure.BoldText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bsTitleTV"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@color/error_color"
            android:paddingStart="@dimen/_10sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:textColor="@color/white"
            android:visibility="gone" />

        <!--    <View-->
        <!--        android:id="@+id/bsDivider"-->
        <!--        android:layout_width="match_parent"-->
        <!--        android:layout_height="0.5dp"-->
        <!--        android:layout_below="@+id/bsTitleTV"-->
        <!--        android:layout_marginBottom="@dimen/_15sdp"-->
        <!--        android:background="@color/red_shade_dark" />-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bottomSheetRV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/submitBtn"
            android:layout_below="@+id/bsErrorTV"
            android:fadeScrollbars="false"
            android:padding="@dimen/_3sdp"
            android:scrollbarSize="@dimen/_3sdp"
            android:scrollbarThumbVertical="@color/red_color"
            android:scrollbars="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <Button
            android:id="@+id/submitBtn"
            style="@style/Theme.AppStructure.ButtonStyle"
            android:background="@null"
            android:text="@string/submit"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_alignParentBottom="true"
            android:visibility="gone" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>