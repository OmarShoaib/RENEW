<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemLayout"
    style="@style/cardView"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/border_radius"
    app:cardElevation="@dimen/card_elevation">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_8sdp">

        <TextView
            android:id="@+id/siteAC"
            style="@style/Theme.AppStructure.RegularText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="@dimen/_10sdp"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_regular"
            android:maxLines="1"
            android:textColor="@color/text_color_light"
            tools:text="70001" />

        <TextView
            android:id="@+id/memberNameTV"
            style="@style/Theme.AppStructure.TitleBoldText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/siteAC"
            android:layout_alignStart="@+id/siteAC"
            android:layout_marginEnd="@dimen/_10sdp"
            android:fontFamily="@font/roboto_regular"
            android:maxLines="2"
            android:textColor="@color/secondary_color"
            tools:text="Ayesha Tahir" />

        <LinearLayout
            android:id="@+id/infoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/memberNameTV"
            android:layout_alignStart="@+id/memberNameTV"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/usernameTV"
                style="@style/Theme.AppStructure.SmallRegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:textColor="@color/gray_dark"
                tools:text="by Username" />

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@color/divider_color_light" />

            <TextView
                android:id="@+id/checkedIdTV"
                style="@style/Theme.AppStructure.SmallRegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:textColor="@color/gray_dark"
                tools:text="A-0001-001" />

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@color/divider_color_light" />

            <TextView
                android:id="@+id/sysDateTV"
                style="@style/Theme.AppStructure.SmallRegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:textColor="@color/gray_dark"
                tools:text="Saved At - 2023-10-01" />

        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>