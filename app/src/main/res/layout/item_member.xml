<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/itemLayout"
        style="@style/cardView"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/border_radius"
        app:cardElevation="@dimen/card_elevation">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_centerVertical="true"
                android:background="@color/female_color_light"
                android:padding="@dimen/_3sdp"
                android:src="@drawable/ic_male"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/lineNoTV"
                style="@style/Theme.AppStructure.SmallRegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_toEndOf="@+id/iv"
                android:textColor="@color/gray_dark"
                tools:text="Line No. 1" />

            <TextView
                android:id="@+id/nameTV"
                style="@style/Theme.AppStructure.BoldText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lineNoTV"
                android:layout_alignStart="@+id/lineNoTV"
                android:textColor="@color/primary_color"
                tools:text="Member Name" />

            <!--<TextView
                android:id="@+id/sNoTV"
                style="@style/Theme.AppStructure.SmallRegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nameTV"
                android:layout_alignStart="@+id/nameTV"
                android:layout_alignEnd="@+id/nameTV"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:textColor="@color/gray_dark"
                tools:text="S No. 1" />-->

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_below="@+id/nameTV"
                android:layout_alignStart="@+id/lineNoTV"
                android:layout_alignEnd="@id/icArrow"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@color/divider_color_light"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icArrow"
                style="@style/Theme.AppStructure.RegularText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_15sdp"
                android:background="@drawable/ic_item_right_arrow"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/completeFlagIV"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_toStartOf="@+id/icArrow"
                android:background="@drawable/ic_baseline_tick_green"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</layout>