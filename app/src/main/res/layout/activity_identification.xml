<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.IdentificationAC">

    <data>

        <import type="android.view.View" />

        <variable
            name="form"
            type="edu.aku.omarshoaib.renew.model.Form1.SF1" />

    </data>

    <LinearLayout
        style="@style/Theme.AppStructure.Background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_appbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/main_padding">

            <LinearLayout
                android:id="@+id/GrpName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- district  Input   -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/fldGrpCVo102"
                    style="@style/cardView">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/quesNum"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/Q_dist" />

                        <TextView
                            style="@style/labels"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/dist" />

                        <EditText
                            android:id="@+id/a102"
                            style="@style/Theme.AppStructure.EditTextStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.9"
                            android:enabled="false"
                            android:gravity="center"
                            android:hint="@string/dist"
                            android:inputType="text"
                            android:text="@={form.dist}"
                            tools:ignore="Autofill" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- sNo  Input   -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/fldGrpCVo107"
                    style="@style/cardView">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/quesNum"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/Q_scrid" />

                        <TextView
                            style="@style/labels"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/scrid" />

                        <com.edittextpicker.aliazaz.EditTextPicker
                            android:id="@+id/a107"
                            style="@style/Theme.AppStructure.EditTextStyle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:hint="###"
                            android:inputType="textCapCharacters|textVisiblePassword"
                            android:maxLength="3"
                            android:text="@={form.scrid}"
                            app:mask="###"
                            app:pattern="[0-9]{3}" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/syncedStatusTV"
                    style="@style/Theme.AppStructure.BoldText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_17sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_rounded_white_filled"
                    android:backgroundTint="@color/success_color"
                    android:gravity="center"
                    android:padding="0dp"
                    android:text="@string/synced_desc"
                    android:textColor="@color/white"
                    android:visibility="gone" />

                <edu.aku.omarshoaib.renew.global.views.AppEndButtons
                    android:id="@+id/endButtonsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:btnNegVisible="-1"
                    app:btnPosEnabled="false" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</layout>